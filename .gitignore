# SQLite databases — user data, lives only on the local machine
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# CSV exports from SSMS / BC pulls
*.csv

# Log files (e.g. scheduled refresh output)
*.log

# Historical / legacy data staging
historical/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# OS noise
.DS_Store
Thumbs.db

# Editor noise
.vscode/
.idea/
*.swp

# Supabase config (holds keys) — never commit. config.local.js is the on-prem
# override; config.js is generated at deploy from a Cloudflare secret.
supabase/config.local.js
supabase/config.js

# Backlog refresh local config (OAuth secret) — never commit
backlog/refresh_config.local.json
